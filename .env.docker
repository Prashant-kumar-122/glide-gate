# Docker Environment Configuration
# Database
DB_USER=postgres
DB_PASSWORD=Root
DB_NAME=glide_gate
DB_HOST=postgres
DB_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://postgres:Root@postgres:5432/glide_gate
DATABASE_URL_SYNC=postgresql://postgres:Root@postgres:5432/glide_gate

# AI Providers (from your .env)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...cd
GOOGLE_API_KEY=...
LOCAL_MODEL_ENDPOINT=http://host.docker.internal:11434/v1

# Primary LLM Config
PRIMARY_LLM_PROVIDER=anthropic
PRIMARY_LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.95
LLM_SEED=42
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0
LLM_MAX_TOKENS=4096
LLM_CACHE_TTL=300
LLM_MAX_RETRIES=3

# JWT / Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# App
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api

# Demo Mode
DEMO_MODE=false

# Document Storage
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=glide-gate-docs

# WebSocket
SOCKETIO_CORS_ORIGINS=["http://localhost:5173"]

# MCP Connectors
MCP_IDENTITY_VERIFICATION_URL=
MCP_DOCUMENT_MANAGEMENT_URL=
MCP_SIMULATED_LATENCY_MIN_MS=100
MCP_SIMULATED_LATENCY_MAX_MS=800
