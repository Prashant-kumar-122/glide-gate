# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:Root@localhost:5432/glide_gate
DATABASE_URL_SYNC=postgresql://postgres:Root@localhost:5432/glide_gate

# ─── AI Providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
LOCAL_MODEL_ENDPOINT=http://localhost:11434/v1

# ─── Primary LLM Config ──────────────────────────────────────────────────────
PRIMARY_LLM_PROVIDER=local
PRIMARY_LLM_MODEL=qwen2.5vl:7b
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.95
LLM_SEED=42
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0
LLM_MAX_TOKENS=4096
LLM_CACHE_TTL=300
LLM_MAX_RETRIES=3

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api

# ─── Demo Mode ───────────────────────────────────────────────────────────────
# Set to true to use pre-canned LLM responses (reliable for live demos)
DEMO_MODE=false

# ─── Document Storage ────────────────────────────────────────────────────────
DOCUMENT_STORAGE_BACKEND=local         # local | s3
DOCUMENT_STORAGE_PATH=./uploads
# S3 (when DOCUMENT_STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=glide-gate-docs

# ─── WebSocket ───────────────────────────────────────────────────────────────
SOCKETIO_CORS_ORIGINS=http://localhost:5173

# ─── Email Notifications ─────────────────────────────────────────────────────
EMAIL_ENABLED=false
RESEND_API_KEY=re_...                      # get from resend.com (free tier)
# Use onboarding@resend.dev for testing (no domain verification needed).
# For production, verify your own domain in Resend and use that address.
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev
NOTIFICATION_FROM_NAME=GlideGate

# ─── Temporal Orchestration (Phase 0.5+) ─────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
# Task queue must match the worker registration in AgentOrchestrationService
TEMPORAL_TASK_QUEUE=onboarding

# ─── MCP Connectors ──────────────────────────────────────────────────────────
MCP_IDENTITY_VERIFICATION_URL=     # leave blank → simulated
MCP_DOCUMENT_MANAGEMENT_URL=       # leave blank → simulated
MCP_SIMULATED_LATENCY_MIN_MS=100
MCP_SIMULATED_LATENCY_MAX_MS=800

# ─── Docs Gate ───────────────────────────────────────────────────────────────
# warn (default): print warning but allow commit; block: reject commit with no docs
DOCS_GATE=warn
